# 실제 사용 시 .env 로 복사하고 값을 채운다.  cp .env.example .env
# .env 는 절대 커밋하지 말 것.

# Grafana 관리자 계정 (admin/admin 기본값 금지)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# 도메인으로 노출하므로 실제 URL 을 넣는다.
# 이 값이 틀리면 알림 메시지의 대시보드 링크가 localhost 로 걸린다.
GF_ROOT_URL=https://grafana.idta.store

# Discord 웹후크 URL. 없으면 알림은 Grafana UI 에만 뜬다.
# Discord 서버 설정 → 연동 → 웹후크 에서 만든다.
DISCORD_WEBHOOK_URL=

# Actuator 스크레이프 전용 계정 (SecurityConfig 에서 permitAll 로 열면 불필요)
PROM_SCRAPE_USER=
PROM_SCRAPE_PASSWORD=
