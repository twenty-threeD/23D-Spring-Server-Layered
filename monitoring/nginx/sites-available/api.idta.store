# 기존 파일에서 바뀐 곳은 location /actuator 블록 하나뿐이다.
# 나머지는 서버에 있던 내용 그대로다.

server {
    listen 80;
    server_name api.idta.store;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.idta.store;

    ssl_certificate     /etc/ssl/cloudflare/idta.store.pem;
    ssl_certificate_key /etc/ssl/cloudflare/idta.store.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # ── 추가 ──────────────────────────────────────────────────────────
    # Actuator 를 외부에 노출하지 않는다.
    # health 만 해도 서비스 구성이 드러나고, prometheus 는 JVM 상태와
    # 전체 엔드포인트 목록·호출량을 그대로 흘린다.
    #
    # Prometheus 스크레이프는 이 경로를 타지 않는다.
    # 컨테이너에서 host.docker.internal:8080 으로 직접 들어가므로
    # 여기서 막아도 수집에는 영향이 없다.
    #
    # location 은 prefix 가 긴 쪽이 우선하므로 아래 location / 보다 먼저 잡힌다.
    location /actuator {
        deny all;
        return 404;
    }
    # ─────────────────────────────────────────────────────────────────

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
